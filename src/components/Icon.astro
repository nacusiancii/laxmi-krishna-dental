---
<svg {...rest} width={width} height={width} viewBox="0 0 24 24" fill="none" stroke="currentColor"
  stroke-width={strokeWidth} stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={paths[name]} />
