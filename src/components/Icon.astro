  tooth: '<path d="M12 3c-4 0-6 3-6 7 0 3 1 4 1.5 7 .3 1.7 1 4 2.5 4s1.5-2.5 2-4c.3-1 .5-1 1-1s.7 0 1 1c.5 1.5.5 4 2 4s2.2-2.3 2.5-4c.5-3 1.5-4 1.5-7 0-4-2-7-6-7z"/>',
  denture: '<path d="M4 13a8 8 0 0 0 16 0v-2H4v2z"/><path d="M8 11v4M12 11v5M16 11v4"/>',
