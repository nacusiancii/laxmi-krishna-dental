---
// Variant: centered statement, doctors side by side underneath. Built with Tailwind utilities on the same tokens.
import Icon from '../Icon.astro';
import { clinic, doctors, whatsappLink, img } from '../../data/clinic';
---
<section class="bg-cream py-16 md:py-24">
  <div class="mx-auto max-w-3xl px-6 text-center">
    <span class="eyebrow justify-center">Two MDS specialists · Kurnool</span>
    <h1 class="mt-4 font-serif text-4xl font-semibold leading-tight text-forest-deep md:text-6xl">
      Calm, honest dentistry <span class="italic text-sage">for the whole family</span>.
    </h1>
    <p class="mx-auto mt-5 max-w-xl text-lg text-muted">
      An oral surgeon and an orthodontist, husband and wife, seeing every patient themselves.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a class="btn btn-wa" href={whatsappLink()} target="_blank" rel="noopener"><Icon name="whatsapp" /> Book on WhatsApp</a>
      <a class="btn btn-outline" href={`tel:${clinic.phone}`}><Icon name="phone" /> Call {clinic.phoneShort}</a>
    </div>
  </div>
  <div class="mx-auto mt-12 grid max-w-3xl grid-cols-2 gap-4 px-6">
    {doctors.map((d) => (
      <figure class="overflow-hidden rounded-3xl border border-line bg-surface shadow-sm">
        <img class="aspect-[4/3] w-full object-cover object-[center_22%]" src={img(d.photo)} alt={d.alt} loading="lazy">
        <figcaption class="p-4 text-left">
          <strong class="block font-serif text-forest-deep">{d.name}</strong>
          <span class="text-sm text-muted">{d.role.split(' · ')[0]}</span>
        </figcaption>
      </figure>
    ))}
  </div>
</section>
