---
// Prototype B: the logo already tells the story. Bracket and wire = Dr. Tulasi, gold implant root = Dr. Sainath.
// Each doctor gets a column with the full desk photo (nameplate and all) and the treatments they do.
import Icon from '../Icon.astro';
import Avatar from './Avatar.astro';
import { services, care, doctors, img, whatsappLink, clinic, type DoctorId } from '../../data/clinic';

const only = (id: DoctorId) => services.filter((s) => care[s.value].by.length === 1 && care[s.value].by[0] === id);
const shared = services.filter((s) => care[s.value].by.length > 1);
const side: Record<DoctorId, { mark: string; ring: string }> = {
  sainath: { mark: 'The gold implant root', ring: 'left:58%;top:72%' },
  tulasi: { mark: 'The bracket and wire', ring: 'left:49%;top:49%' },
};
const [sainath, tulasi] = doctors;
---
<section class="bg-cream-2 py-16" id="proto-b">
  <div class="wrap">
    <div class="mx-auto mb-10 max-w-2xl text-center">
      <span class="eyebrow">Who does what</span>
      <h2 class="mt-2 text-[clamp(1.8rem,3.4vw,2.5rem)]">Two specialists, one tooth.</h2>
      <p class="mt-3 text-muted">Look closely at our logo: a bracket on the crown, an implant for the root. One for each of us.</p>
    </div>

    <div class="grid items-start gap-6 lg:grid-cols-[1fr_260px_1fr]">
      {[sainath, null, tulasi].map((d) => d === null ? (
        <figure class="order-first mx-auto w-56 lg:order-none lg:sticky lg:top-28 lg:w-full">
          <div class="relative">
            <img src={img('logo.jpg')} alt="Clinic logo: a tooth with a brace bracket and an implant root" class="w-full rounded-full shadow-md" />
            {(['sainath', 'tulasi'] as DoctorId[]).map((id) => (
              <span class="b-ring pointer-events-none absolute h-[22%] w-[22%] -translate-x-1/2 -translate-y-1/2 rounded-full border-[3px] border-gold opacity-0" data-ring={id} style={side[id].ring} />
            ))}
          </div>
          <figcaption class="mt-4 hidden text-center text-sm text-muted lg:block">Hover a treatment to see whose half of the tooth it is.</figcaption>
        </figure>
      ) : (
        <article class="b-col rounded-[var(--radius)] bg-surface p-3 shadow-sm" data-doc={d.id}>
          <img src={img(d.photo)} alt={d.alt} loading="lazy" class="aspect-[3/4] max-h-[420px] w-full rounded-[14px] object-cover object-[50%_60%]" />
          <div class="p-4">
            <div class="text-xs font-bold uppercase tracking-[0.12em] text-gold">{side[d.id].mark}</div>
            <h3 class="mt-1 text-2xl">{d.short}</h3>
            <p class="text-sm text-muted">{d.specialty}</p>
            <ul class="mt-4 divide-y divide-line border-y border-line">
              {only(d.id).map((s) => (
                <li>
                  <details class="b-item group">
                    <summary class="flex cursor-pointer list-none items-center gap-3 py-3 font-semibold text-forest-deep">
                      <Icon name={s.icon} width={20} class="text-gold" /> {s.name}
                      <span class="ml-auto text-muted transition-transform group-open:rotate-45">+</span>
                    </summary>
                    <ol class="mb-3 ml-8 list-decimal space-y-1 text-sm text-ink marker:text-gold">
                      {care[s.value].steps.map((step) => <li>{step}</li>)}
                    </ol>
                    {care[s.value].urgent && <p class="mb-3 ml-8 text-sm font-semibold text-forest">{care[s.value].urgent}</p>}
                    <a class="mb-4 ml-8 inline-flex items-center gap-2 text-sm font-bold text-whatsapp" target="_blank" rel="noopener"
                      href={whatsappLink(`Hello ${d.short}, I would like to ask about ${s.name}.`)}>
                      <Icon name="whatsapp" width={16} /> Ask {d.short} on WhatsApp
                    </a>
                  </details>
                </li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </div>

    <div class="mt-6 rounded-[var(--radius)] border border-line bg-surface p-6 shadow-sm md:flex md:items-center md:gap-8">
      <div class="flex items-center gap-3 md:w-64 md:shrink-0">
        <span class="flex -space-x-4"><Avatar id="sainath" size={52} /><Avatar id="tulasi" size={52} /></span>
        <div><h3 class="text-lg">Either of us</h3><p class="text-xs text-muted">Whoever is in at your slot</p></div>
      </div>
      <div class="mt-4 flex flex-wrap gap-2 md:mt-0">
        {shared.map((s) => (
          <a class="inline-flex items-center gap-2 rounded-full border border-line px-4 py-2 text-sm font-semibold text-forest-deep hover:border-forest" target="_blank" rel="noopener"
            href={whatsappLink(`Hello doctors, I would like to ask about ${s.name}.`)}>
            <Icon name={s.icon} width={16} class="text-gold" /> {s.name}
          </a>
        ))}
        <a class="inline-flex items-center gap-2 rounded-full bg-forest px-4 py-2 text-sm font-semibold text-white" href={`tel:${clinic.phone}`}>
          <Icon name="phone" width={16} /> Not sure? Call us
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .b-ring { transition: opacity 0.3s, transform 0.4s var(--ease-out); box-shadow: 0 0 0 6px rgba(182, 141, 64, 0.18); }
  .b-ring.on { opacity: 1; animation: b-pulse 1.6s ease-in-out infinite; }
  @keyframes b-pulse { 50% { box-shadow: 0 0 0 14px rgba(182, 141, 64, 0); } }
  .b-col { transition: transform 0.3s var(--ease-out), box-shadow 0.3s; }
  .b-col.on { transform: translateY(-4px); box-shadow: var(--shadow-md); }
  @media (prefers-reduced-motion: reduce) { .b-ring.on { animation: none; } }
</style>

<script>
  // Point at a doctor's column (or open one of their treatments): ring their half of the logo.
  const root = document.getElementById('proto-b')!;
  const rings = root.querySelectorAll<HTMLElement>('[data-ring]');
  const light = (id?: string) => {
    rings.forEach((r) => r.classList.toggle('on', r.dataset.ring === id));
    root.querySelectorAll<HTMLElement>('.b-col').forEach((c) => c.classList.toggle('on', c.dataset.doc === id));
  };
  root.querySelectorAll<HTMLElement>('.b-col').forEach((col) => {
    col.addEventListener('pointerenter', () => light(col.dataset.doc));
    col.addEventListener('pointerleave', () => light());
    col.querySelectorAll('details').forEach((d) => d.addEventListener('toggle', () => d.open && light(col.dataset.doc)));
  });
</script>
