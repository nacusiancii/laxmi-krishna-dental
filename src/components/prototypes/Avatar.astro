---
// A round close-up of a doctor, cut from the desk photo around their face.
import { doctorById, img, type DoctorId } from '../../data/clinic';
interface Props { id: DoctorId; size?: number; class?: string }
const { id, size = 56, class: cls } = Astro.props;
const d = doctorById(id);
const zoom = 3.2; // photo width = 3.2 × the circle
const ratio = 4 / 3; // the photos are 3:4 portraits
// background-position % that puts the face in the middle of the circle
const px = ((d.face.x * zoom - 0.5) / (zoom - 1)) * 100;
const py = ((d.face.y * zoom * ratio - 0.5) / (zoom * ratio - 1)) * 100;
---
<span role="img" aria-label={d.name} class:list={['inline-block shrink-0 rounded-full border-2 border-surface bg-cream-2 shadow-sm', cls]}
  style={`width:${size}px;height:${size}px;background:url(${img(d.photo)}) ${px.toFixed(1)}% ${py.toFixed(1)}% / ${zoom * 100}% auto no-repeat`} />
