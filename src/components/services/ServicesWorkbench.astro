---
// Prototype S1: Pick by Specialist — puts the two MDS doctors first, then their treatments,
// first-visit walkthrough, and a live WhatsApp message preview.
import Icon from '../Icon.astro';
import { clinic, doctors, services, whatsappNumber, img } from '../../data/clinic';

const drSainath = doctors.find((d) => d.id === 'sainath')!;
const drTulasi = doctors.find((d) => d.id === 'tulasi')!;

const groups = [
  {
    id: 'sainath',
    label: drSainath.shortName,
    sub: 'Oral Surgery & Implants',
    photos: [drSainath.photo],
    count: services.filter((s) => s.doctor === 'sainath').length,
  },
  {
    id: 'tulasi',
    label: drTulasi.shortName,
    sub: 'Braces, Aligners & Smiles',
    photos: [drTulasi.photo],
    count: services.filter((s) => s.doctor === 'tulasi').length,
  },
  {
    id: 'both',
    label: 'Both Specialists',
    sub: 'Family & Restorative Care',
    photos: [drSainath.photo, drTulasi.photo],
    count: services.filter((s) => s.doctor === 'both').length,
  },
];

const payload = services.map((s) => {
  const dr = s.doctor === 'sainath' ? drSainath : s.doctor === 'tulasi' ? drTulasi : null;
  const greeting = dr
    ? `Hello ${dr.shortName}, I would like to book a consultation for ${s.name} at Laxmi Krishna Dental.`
    : `Hello Dr. Sainath & Dr. Krishna Tulasi, I would like to book a consultation for ${s.name} at Laxmi Krishna Dental.`;
  return {
    ...s,
    doctorLabel: dr ? dr.name : `${drSainath.shortName} & ${drTulasi.shortName}`,
    doctorRole: dr ? dr.role : 'Both MDS Specialists · Family & Restorative Care',
    doctorPhotos: dr ? [img(dr.photo)] : [img(drSainath.photo), img(drTulasi.photo)],
    waMessage: greeting,
    waHref: `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(greeting)}`,
  };
});
---
<section class="bg-cream py-14" data-proto="workbench">
  <div class="mx-auto max-w-[1120px] px-6">
    <div class="max-w-2xl">
      <span class="eyebrow">Who Treats You</span>
      <h2 class="mt-2 font-serif text-3xl font-bold text-forest-deep md:text-4xl">
        Pick a specialist, see what Visit 1 looks like.
      </h2>
      <p class="mt-2 text-muted">
        At Laxmi Krishna Dental, every treatment is done directly by one of our two MDS doctors — never handed off.
      </p>
    </div>

    {/* Specialist selector cards */}
    <div class="mt-7 grid gap-3 sm:grid-cols-3" role="tablist" aria-label="Choose a specialist">
      {groups.map((g, idx) => (
        <button
          type="button"
          role="tab"
          aria-selected={idx === 0 ? 'true' : 'false'}
          data-wb-group={g.id}
          class:list={[
            'wb-tab group flex items-center gap-3.5 rounded-2xl border p-3.5 text-left transition-all cursor-pointer',
            idx === 0
              ? 'border-forest bg-forest text-white shadow-sm'
              : 'border-line bg-surface text-forest-deep hover:border-gold-light',
          ]}
        >
          <div class="flex shrink-0 -space-x-2.5">
            {g.photos.map((p) => (
              <span class="h-12 w-12 overflow-hidden rounded-full border-2 border-gold-light bg-cream-2">
                <img src={img(p)} alt="" class="h-full w-full object-cover object-[44%_40%] scale-[2.1]" />
              </span>
            ))}
          </div>
          <div class="min-w-0 flex-1">
            <div class="flex items-center justify-between gap-2">
              <strong class="truncate font-serif text-base font-semibold">{g.label}</strong>
              <span class="wb-count shrink-0 rounded-full bg-white/15 px-2 py-0.5 text-xs font-semibold">
                {g.count}
              </span>
            </div>
            <span class="wb-sub block truncate text-xs opacity-80">{g.sub}</span>
          </div>
        </button>
      ))}
    </div>

    {/* Two-column workbench: treatment list left, visit stage right */}
    <div class="mt-6 grid gap-6 lg:grid-cols-[0.92fr_1.08fr] lg:items-start">
      <div class="flex flex-col gap-2.5" data-wb-list>
        {payload.map((s, idx) => (
          <button
            type="button"
            data-wb-item={idx}
            data-wb-doctor={s.doctor}
            class:list={[
              'wb-item flex items-center gap-3.5 rounded-2xl border p-4 text-left transition-all cursor-pointer',
              s.doctor !== 'sainath' && 'hidden',
              idx === 0
                ? 'border-forest bg-surface ring-2 ring-gold-light/70 shadow-sm'
                : 'border-line bg-surface/70 hover:bg-surface hover:border-gold-light',
            ]}
          >
            <div class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-sage-soft text-forest">
              <Icon name={s.icon} width={20} strokeWidth={1.8} />
            </div>
            <div class="min-w-0 flex-1">
              <div class="flex items-center gap-2">
                <strong class="font-serif text-base font-semibold text-forest-deep">{s.name}</strong>
                {s.urgent && (
                  <span class="rounded-full bg-gold-soft px-2 py-0.5 text-[11px] font-bold uppercase tracking-wide text-gold">
                    Same-day
                  </span>
                )}
              </div>
              <span class="block truncate text-xs text-muted">{s.symptom}</span>
            </div>
            <span class="text-sm font-bold text-gold">→</span>
          </button>
        ))}
      </div>

      {/* Right stage: specialist + Visit 1 + live WhatsApp preview */}
      <div class="rounded-3xl border border-line bg-surface p-6 shadow-sm md:p-7" data-wb-stage aria-live="polite">
        <div class="flex flex-wrap items-center gap-3.5 border-b border-line pb-5">
          <div class="flex shrink-0 -space-x-3" data-wb-photos>
            <span class="h-14 w-14 overflow-hidden rounded-full border-2 border-gold-light bg-cream-2">
              <img src={payload[0].doctorPhotos[0]} alt="" class="h-full w-full object-cover object-[44%_40%] scale-[2.1]" />
            </span>
          </div>
          <div class="min-w-0 flex-1">
            <span class="text-[11px] font-bold uppercase tracking-widest text-gold">Your Specialist</span>
            <h3 class="font-serif text-lg font-bold text-forest-deep" data-wb-doc-name>{payload[0].doctorLabel}</h3>
            <p class="text-xs text-muted" data-wb-doc-role>{payload[0].doctorRole}</p>
          </div>
        </div>

        <div class="mt-5">
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h4 class="font-serif text-2xl font-bold text-forest-deep" data-wb-title>{payload[0].name}</h4>
            <span class="rounded-full bg-sage-soft px-3 py-1 text-xs font-semibold text-forest" data-wb-tag>{payload[0].tag}</span>
          </div>
          <p class="mt-2 text-sm leading-relaxed text-muted" data-wb-blurb>{payload[0].blurb}</p>
        </div>

        <div class="mt-5 grid gap-3 sm:grid-cols-2">
          <div class="rounded-2xl bg-gold-soft/80 p-4">
            <span class="text-[11px] font-bold uppercase tracking-wider text-gold">What happens on Visit 1</span>
            <p class="mt-1 text-sm text-forest-deep" data-wb-visit>{payload[0].firstVisit}</p>
          </div>
          <div class="rounded-2xl bg-cream p-4">
            <span class="text-[11px] font-bold uppercase tracking-wider text-sage">Good to know</span>
            <p class="mt-1 text-sm text-forest-deep" data-wb-know>{payload[0].goodToKnow}</p>
          </div>
        </div>

        {/* Live WhatsApp preview */}
        <div class="mt-5 rounded-2xl border border-line bg-cream/70 p-4">
          <span class="text-[11px] font-bold uppercase tracking-wider text-muted">Pre-filled WhatsApp message</span>
          <p class="mt-1.5 rounded-xl bg-surface px-3.5 py-2.5 text-sm italic text-forest-deep border border-line/70" data-wb-preview>
            “{payload[0].waMessage}”
          </p>
          <div class="mt-3.5 flex flex-wrap gap-2.5">
            <a class="btn btn-wa btn-sm" data-wb-wa href={payload[0].waHref} target="_blank" rel="noopener">
              <Icon name="whatsapp" width={16} /> Message on WhatsApp
            </a>
            <a class="btn btn-outline btn-sm" href={`tel:${clinic.phone}`}>
              <Icon name="phone" width={16} /> Call {clinic.phoneShort}
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script type="application/json" data-wb-json set:html={JSON.stringify(payload)} />
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-proto="workbench"]').forEach((root) => {
    const data = JSON.parse(root.querySelector('[data-wb-json]')!.textContent!);
    const tabs = root.querySelectorAll<HTMLButtonElement>('[data-wb-group]');
    const items = root.querySelectorAll<HTMLButtonElement>('[data-wb-item]');
    const photosEl = root.querySelector('[data-wb-photos]')!;
    const docNameEl = root.querySelector('[data-wb-doc-name]')!;
    const docRoleEl = root.querySelector('[data-wb-doc-role]')!;
    const titleEl = root.querySelector('[data-wb-title]')!;
    const tagEl = root.querySelector('[data-wb-tag]')!;
    const blurbEl = root.querySelector('[data-wb-blurb]')!;
    const visitEl = root.querySelector('[data-wb-visit]')!;
    const knowEl = root.querySelector('[data-wb-know]')!;
    const previewEl = root.querySelector('[data-wb-preview]')!;
    const waEl = root.querySelector<HTMLAnchorElement>('[data-wb-wa]')!;

    function selectItem(idx: number) {
      const s = data[idx];
      items.forEach((btn) => {
        const on = Number(btn.dataset.wbItem) === idx;
        btn.classList.toggle('border-forest', on);
        btn.classList.toggle('bg-surface', on);
        btn.classList.toggle('ring-2', on);
        btn.classList.toggle('ring-gold-light/70', on);
        btn.classList.toggle('shadow-sm', on);
        btn.classList.toggle('border-line', !on);
        btn.classList.toggle('bg-surface/70', !on);
      });
      photosEl.innerHTML = s.doctorPhotos
        .map((src: string) => `<span class="h-14 w-14 overflow-hidden rounded-full border-2 border-gold-light bg-cream-2"><img src="${src}" alt="" class="h-full w-full object-cover object-[44%_40%] scale-[2.1]" /></span>`)
        .join('');
      docNameEl.textContent = s.doctorLabel;
      docRoleEl.textContent = s.doctorRole;
      titleEl.textContent = s.name;
      tagEl.textContent = s.tag;
      blurbEl.textContent = s.blurb;
      visitEl.textContent = s.firstVisit;
      knowEl.textContent = s.goodToKnow;
      previewEl.textContent = `“${s.waMessage}”`;
      waEl.href = s.waHref;
    }

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const g = tab.dataset.wbGroup!;
        tabs.forEach((t) => {
          const on = t === tab;
          t.setAttribute('aria-selected', String(on));
          t.classList.toggle('border-forest', on);
          t.classList.toggle('bg-forest', on);
          t.classList.toggle('text-white', on);
          t.classList.toggle('shadow-sm', on);
          t.classList.toggle('border-line', !on);
          t.classList.toggle('bg-surface', !on);
          t.classList.toggle('text-forest-deep', !on);
        });
        let firstIdx = -1;
        items.forEach((btn) => {
          const show = btn.dataset.wbDoctor === g;
          btn.classList.toggle('hidden', !show);
          if (show && firstIdx === -1) firstIdx = Number(btn.dataset.wbItem);
        });
        if (firstIdx >= 0) selectItem(firstIdx);
      });
    });

    items.forEach((btn) => btn.addEventListener('click', () => selectItem(Number(btn.dataset.wbItem))));
  });
</script>
