---
// Prototype S2 (Mobile-First): Start with What You're Feeling — swipeable horizontal
// symptom card deck on phones (5-col mosaic on desktop) so the matched specialist card
// stays immediately visible in the same viewport.
import Icon from '../Icon.astro';
import { clinic, doctors, services, whatsappNumber, img } from '../../data/clinic';

const drSainath = doctors.find((d) => d.id === 'sainath')!;
const drTulasi = doctors.find((d) => d.id === 'tulasi')!;

const payload = services.map((s) => {
  const dr = s.doctor === 'sainath' ? drSainath : s.doctor === 'tulasi' ? drTulasi : null;
  const waText = dr
    ? `Hello ${dr.shortName}, I'm experiencing "${s.symptom.toLowerCase()}" and would like to consult about ${s.name}.`
    : `Hello Laxmi Krishna Dental, I'm experiencing "${s.symptom.toLowerCase()}" and would like to book a visit for ${s.name}.`;
  return {
    ...s,
    doctorLabel: dr ? dr.name : `${drSainath.shortName} & ${drTulasi.shortName}`,
    doctorShort: dr ? dr.shortName : 'the Clinic',
    doctorRole: dr ? dr.shortRole : 'Family & Restorative Care',
    doctorPhotos: dr ? [img(dr.photo)] : [img(drSainath.photo), img(drTulasi.photo)],
    waHref: `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(waText)}`,
  };
});
---
<section class="bg-cream-2 py-6 sm:py-12" data-proto="symptom">
  <div class="mx-auto max-w-[1120px] px-4 sm:px-6">
    <div class="flex flex-wrap items-end justify-between gap-3">
      <div class="max-w-xl">
        <span class="eyebrow">Patient-First Guide</span>
        <h2 class="mt-1.5 font-serif text-2xl font-bold text-forest-deep sm:text-3xl md:text-4xl">
          Tap what you’re feeling.
        </h2>
      </div>
      <button
        type="button"
        data-sym-urgent
        aria-pressed="false"
        class="inline-flex items-center gap-2 rounded-full border border-gold bg-gold-soft px-3.5 py-1.5 text-xs font-semibold text-forest-deep transition-all hover:bg-forest hover:border-forest hover:text-white cursor-pointer sm:px-4 sm:py-2 sm:text-sm"
      >
        <span class="h-2 w-2 rounded-full bg-gold"></span>
        In pain today?
      </button>
    </div>

    {/* Urgent banner (hidden until toggled) */}
    <div data-sym-banner class="mt-3.5 hidden">
      <div class="flex items-center justify-between gap-3 rounded-2xl border border-gold-light bg-forest-deep px-4 py-3 text-white">
        <div class="min-w-0">
          <strong class="block font-serif text-sm text-gold-light sm:text-base">In pain or swelling today?</strong>
          <p class="text-xs text-white/85 sm:text-sm">Call directly — we keep same-day room for urgent care.</p>
        </div>
        <a class="btn btn-wa btn-sm shrink-0" href={`tel:${clinic.phone}`}>
          <Icon name="phone" width={15} /> Call
        </a>
      </div>
    </div>

    {/* Mobile: horizontal snap deck (215px cards so the next card peeks in from the right).
        Desktop (lg+): 5-column mosaic. */}
    <div
      class="-mx-4 mt-4 flex gap-2.5 overflow-x-auto px-4 pb-1 snap-x snap-mandatory scroll-px-4 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden sm:mx-0 sm:px-0 sm:scroll-px-0 lg:mt-6 lg:grid lg:grid-cols-5 lg:gap-3 lg:overflow-visible lg:pb-0"
      data-sym-grid
    >
      {payload.map((s, idx) => (
        <button
          type="button"
          data-sym-card={idx}
          data-urgent={s.urgent ? 'true' : 'false'}
          class:list={[
            'sym-card flex w-[210px] shrink-0 snap-start flex-col justify-between rounded-2xl border p-3.5 text-left transition-all cursor-pointer lg:w-auto lg:p-4',
            idx === 0
              ? 'border-forest bg-forest text-white shadow-md'
              : 'border-line bg-surface text-forest-deep hover:border-gold-light',
          ]}
        >
          <div>
            <div class="flex items-center justify-between gap-2">
              <span class:list={['text-[10px] font-bold uppercase tracking-wider', idx === 0 ? 'text-gold-light' : 'text-gold']}>
                {s.urgent ? 'Urgent care' : s.tag}
              </span>
              <div class="flex -space-x-1.5">
                {s.doctorPhotos.map((src) => (
                  <span class="h-6 w-6 overflow-hidden rounded-full border border-gold-light bg-cream-2">
                    <img src={src} alt="" class="h-full w-full object-cover object-[44%_40%] scale-[2.2]" />
                  </span>
                ))}
              </div>
            </div>
            <p class:list={['mt-2 font-serif text-sm font-semibold leading-snug lg:text-[15px]', idx === 0 ? 'text-white' : 'text-forest-deep']}>
              “{s.symptom}”
            </p>
          </div>
          <span class:list={['mt-2.5 block text-[11px] font-semibold', idx === 0 ? 'text-white/75' : 'text-muted']}>
            {s.name}
          </span>
        </button>
      ))}
    </div>

    {/* Matched specialist card — immediately below the swipe deck on mobile */}
    <div class="mt-3.5 overflow-hidden rounded-3xl border border-gold-light bg-surface shadow-sm lg:mt-6" data-sym-panel aria-live="polite">
      <div class="grid min-w-0 md:grid-cols-[0.82fr_1.18fr]">
        <div class="flex min-w-0 items-center gap-3.5 bg-forest-deep px-4 py-4 text-white sm:p-6">
          <div class="flex shrink-0 -space-x-2.5" data-sym-photos>
            {payload[0].doctorPhotos.map((src) => (
              <span class="h-12 w-12 overflow-hidden rounded-full border-2 border-gold-light bg-cream-2 sm:h-15 sm:w-15">
                <img src={src} alt="" class="h-full w-full object-cover object-[44%_40%] scale-[2.1]" />
              </span>
            ))}
          </div>
          <div class="min-w-0 flex-1">
            <span class="text-[10px] font-bold uppercase tracking-widest text-gold-light">You’ll see</span>
            <h3 class="truncate font-serif text-lg font-bold text-white sm:text-xl" data-sym-doc>{payload[0].doctorLabel}</h3>
            <p class="truncate text-xs text-white/80" data-sym-role>{payload[0].doctorRole}</p>
          </div>
        </div>

        <div class="flex min-w-0 flex-col justify-between gap-3.5 p-4 sm:p-6">
          <div class="min-w-0">
            <strong class="block font-serif text-lg text-forest-deep sm:text-xl" data-sym-name>{payload[0].name}</strong>
            <p class="mt-1.5 text-xs leading-relaxed text-muted sm:text-sm" data-sym-visit>
              <strong class="text-forest-deep">Visit 1:</strong> {payload[0].firstVisit}
            </p>
            <p class="mt-1 text-xs leading-relaxed text-muted sm:text-sm" data-sym-know>{payload[0].goodToKnow}</p>
          </div>
          <div class="grid min-w-0 grid-cols-[1fr_auto] gap-2 sm:flex sm:flex-wrap">
            <a class="btn btn-wa btn-sm min-w-0 justify-center px-3" data-sym-wa href={payload[0].waHref} target="_blank" rel="noopener">
              <Icon name="whatsapp" width={16} /> <span class="truncate" data-sym-cta>WhatsApp {payload[0].doctorShort}</span>
            </a>
            <a class="btn btn-outline btn-sm shrink-0 justify-center px-3.5" href={`tel:${clinic.phone}`}>
              <Icon name="phone" width={16} /> <span class="hidden sm:inline">Call {clinic.phoneShort}</span><span class="sm:hidden">Call</span>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script type="application/json" data-sym-json set:html={JSON.stringify(payload)} />
</section>

<script>
  document.querySelectorAll<HTMLElement>('[data-proto="symptom"]').forEach((root) => {
    const data = JSON.parse(root.querySelector('[data-sym-json]')!.textContent!);
    const cards = root.querySelectorAll<HTMLButtonElement>('[data-sym-card]');
    const gridEl = root.querySelector<HTMLElement>('[data-sym-grid]')!;
    const urgentBtn = root.querySelector<HTMLButtonElement>('[data-sym-urgent]')!;
    const banner = root.querySelector<HTMLElement>('[data-sym-banner]')!;
    const photosEl = root.querySelector('[data-sym-photos]')!;
    const docEl = root.querySelector('[data-sym-doc]')!;
    const roleEl = root.querySelector('[data-sym-role]')!;
    const nameEl = root.querySelector('[data-sym-name]')!;
    const visitEl = root.querySelector('[data-sym-visit]')!;
    const knowEl = root.querySelector('[data-sym-know]')!;
    const waEl = root.querySelector<HTMLAnchorElement>('[data-sym-wa]')!;
    const ctaEl = root.querySelector('[data-sym-cta]')!;

    function paint(idx: number) {
      const s = data[idx];
      cards.forEach((c) => {
        const on = Number(c.dataset.symCard) === idx;
        c.classList.toggle('border-forest', on);
        c.classList.toggle('bg-forest', on);
        c.classList.toggle('text-white', on);
        c.classList.toggle('shadow-md', on);
        c.classList.toggle('border-line', !on);
        c.classList.toggle('bg-surface', !on);
        c.classList.toggle('text-forest-deep', !on);
        const tag = c.querySelector('span');
        const quote = c.querySelector('p');
        const foot = c.querySelector('span:last-child');
        if (tag) { tag.classList.toggle('text-gold-light', on); tag.classList.toggle('text-gold', !on); }
        if (quote) { quote.classList.toggle('text-white', on); quote.classList.toggle('text-forest-deep', !on); }
        if (foot) { foot.classList.toggle('text-white/75', on); foot.classList.toggle('text-muted', !on); }
      });
      photosEl.innerHTML = s.doctorPhotos
        .map((src: string) => `<span class="h-12 w-12 overflow-hidden rounded-full border-2 border-gold-light bg-cream-2 sm:h-15 sm:w-15"><img src="${src}" alt="" class="h-full w-full object-cover object-[44%_40%] scale-[2.1]" /></span>`)
        .join('');
      docEl.textContent = s.doctorLabel;
      roleEl.textContent = s.doctorRole;
      nameEl.textContent = s.name;
      visitEl.innerHTML = `<strong class="text-forest-deep">Visit 1:</strong> ${s.firstVisit}`;
      knowEl.textContent = s.goodToKnow;
      waEl.href = s.waHref;
      ctaEl.textContent = `WhatsApp ${s.doctorShort}`;
    }

    cards.forEach((c) => c.addEventListener('click', () => paint(Number(c.dataset.symCard))));

    let urgentOnly = false;
    urgentBtn.addEventListener('click', () => {
      urgentOnly = !urgentOnly;
      urgentBtn.setAttribute('aria-pressed', String(urgentOnly));
      urgentBtn.classList.toggle('bg-forest', urgentOnly);
      urgentBtn.classList.toggle('border-forest', urgentOnly);
      urgentBtn.classList.toggle('text-white', urgentOnly);
      urgentBtn.classList.toggle('bg-gold-soft', !urgentOnly);
      urgentBtn.classList.toggle('border-gold', !urgentOnly);
      urgentBtn.classList.toggle('text-forest-deep', !urgentOnly);
      banner.classList.toggle('hidden', !urgentOnly);

      let firstVisible = -1;
      cards.forEach((c) => {
        const show = !urgentOnly || c.dataset.urgent === 'true';
        c.classList.toggle('hidden', !show);
        if (show && firstVisible === -1) firstVisible = Number(c.dataset.symCard);
      });
      gridEl.scrollLeft = 0;
      if (firstVisible >= 0) paint(firstVisible);
    });
  });
</script>
