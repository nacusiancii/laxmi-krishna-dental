---
// Slow, soft flowing light in the clinic's sage & gold. Sits behind the hero (.hero-shader).
// Falls back to the plain cream background when WebGL is missing.
---
<canvas class="hero-shader" id="heroShader" aria-hidden="true"></canvas>

<script>
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  (function heroShader() {
    const el = document.getElementById('heroShader') as HTMLCanvasElement | null;
    const ctx = el && el.getContext('webgl', { antialias: false, alpha: false, powerPreference: 'low-power' });
    if (!el || !ctx) return; // plain cream background stays as fallback
    const canvas = el, gl = ctx; // non-null from here on, also inside the functions below

    const vert = 'attribute vec2 p;void main(){gl_Position=vec4(p,0.,1.);}';
    const frag = `
      precision mediump float;
      uniform vec2 res;
      uniform float t;
      uniform vec2 m;
      // value noise + fbm
      float h(vec2 p){ return fract(sin(dot(p, vec2(127.1, 311.7))) * 43758.5453); }
      float n(vec2 p){
        vec2 i = floor(p), f = fract(p);
        vec2 u = f * f * (3. - 2. * f);
        return mix(mix(h(i), h(i + vec2(1, 0)), u.x), mix(h(i + vec2(0, 1)), h(i + vec2(1, 1)), u.x), u.y);
      }
      float fbm(vec2 p){
        float v = 0., a = .5;
        for (int k = 0; k < 4; k++) { v += a * n(p); p = p * 2.02 + 3.1; a *= .5; }
        return v;
      }
      void main(){
        vec2 uv = gl_FragCoord.xy / res;
        vec2 q = uv * vec2(res.x / res.y, 1.) * 1.6;
        float tt = t * .045;
        // domain warp gives the slow silk-like flow
        vec2 w = vec2(fbm(q + tt), fbm(q + vec2(5.2, 1.3) - tt));
        float f = fbm(q + 2.2 * w + m * .35);

        vec3 cream = vec3(.980, .973, .953);
        vec3 sage  = vec3(.835, .902, .859);
        vec3 gold  = vec3(.937, .871, .733);
        vec3 deep  = vec3(.184, .376, .278);

        vec3 col = mix(cream, sage, smoothstep(.35, .85, f));
        col = mix(col, gold, smoothstep(.45, .95, w.y) * .7);
        col = mix(col, deep, smoothstep(.72, 1., f) * .12);
        // keep the text side (left) calmer than the photo side
        float calm = smoothstep(.0, .75, uv.x) * .75 + .25;
        col = mix(cream, col, calm);
        gl_FragColor = vec4(col, 1.);
      }`;

    function compile(type: number, src: string) {
      const s = gl.createShader(type)!;
      gl.shaderSource(s, src);
      gl.compileShader(s);
      return gl.getShaderParameter(s, gl.COMPILE_STATUS) ? s : null;
    }
    const vs = compile(gl.VERTEX_SHADER, vert);
    const fs = compile(gl.FRAGMENT_SHADER, frag);
    if (!vs || !fs) return;
    const prog = gl.createProgram();
    gl.attachShader(prog, vs);
    gl.attachShader(prog, fs);
    gl.linkProgram(prog);
    if (!gl.getProgramParameter(prog, gl.LINK_STATUS)) return;
    gl.useProgram(prog);

    gl.bindBuffer(gl.ARRAY_BUFFER, gl.createBuffer());
    gl.bufferData(gl.ARRAY_BUFFER, new Float32Array([-1, -1, 3, -1, -1, 3]), gl.STATIC_DRAW);
    const loc = gl.getAttribLocation(prog, 'p');
    gl.enableVertexAttribArray(loc);
    gl.vertexAttribPointer(loc, 2, gl.FLOAT, false, 0, 0);
    const uRes = gl.getUniformLocation(prog, 'res');
    const uT = gl.getUniformLocation(prog, 't');
    const uM = gl.getUniformLocation(prog, 'm');

    // It's a soft blur, so half resolution looks the same and costs a quarter
    const SCALE = 0.5;

    // Pointer nudges the flow a little; eased so it never jumps
    let mx = 0, my = 0, tx = 0, ty = 0;
    window.addEventListener('pointermove', e => {
      tx = e.clientX / window.innerWidth - 0.5;
      ty = 0.5 - e.clientY / window.innerHeight;
    }, { passive: true });

    const start = performance.now();
    let visible = true, raf = 0, last = 0;
    function paint(now: number) {
      gl.uniform1f(uT, (now - start) / 1000 + 40);
      gl.uniform2f(uM, mx, my);
      gl.drawArrays(gl.TRIANGLES, 0, 3);
    }
    // Resizing the canvas clears it, so repaint right away (matters when only one frame is ever drawn)
    function resize() {
      const r = canvas.getBoundingClientRect();
      canvas.width = Math.max(1, Math.round(r.width * SCALE));
      canvas.height = Math.max(1, Math.round(r.height * SCALE));
      gl.viewport(0, 0, canvas.width, canvas.height);
      gl.uniform2f(uRes, canvas.width, canvas.height);
      paint(performance.now());
    }
    resize();
    window.addEventListener('resize', resize);

    function draw(now: number) {
      raf = 0;
      if (now - last >= 33) { // ~30fps is plenty for slow motion
        last = now;
        mx += (tx - mx) * 0.04;
        my += (ty - my) * 0.04;
        paint(now);
      }
      if (visible && !document.hidden && !reduceMotion) raf = requestAnimationFrame(draw);
    }
    const kick = () => { if (!raf && visible && !document.hidden) raf = requestAnimationFrame(draw); };

    // Only animate while the hero is on screen and the tab is visible
    new IntersectionObserver(([e]) => { visible = e.isIntersecting; kick(); }).observe(canvas);
    document.addEventListener('visibilitychange', kick);

    draw(performance.now()); // first frame now (also the only frame with reduced motion)
    canvas.classList.add('ready');
  })();
</script>
